# Proxy do HTTPS na frente da aplicação, na mesma máquina. O certificado do domínio é obtido e
# renovado pelo próprio proxy; com localhost, no ensaio, ele usa uma autoridade local dele.
#
# O X-Forwarded-For que chega de um cliente é descartado, e no lugar vai o endereço de quem se
# conectou ao proxy, junto do X-Forwarded-Proto. A aplicação lê os dois e confia na rede interna
# dos contêineres, de onde o proxy fala com ela.
#
# Sem access log: a aplicação não registra cada requisição, e o endereço de quem acessa só vai aos
# logs nos eventos de segurança dela, como o login e a recusa de acesso. Para medir a borda, liga-se
# o access log da própria aplicação, à mão, e desliga-se depois.
{
	# HTTP/1.1 e HTTP/2, pela porta TCP. O HTTP/3, que o proxy também ligaria por padrão, pediria a
	# porta UDP publicada.
	servers {
		protocols h1 h2
	}
}

{$ECRX_CAIXA_DOMINIO} {
	# Respostas comprimidas para quem aceita, com zstd antes de gzip; quem não manda Accept-Encoding recebe
	# como antes. O JS do aplicativo é o grosso do primeiro acesso e de cada atualização, baixado no balcão
	# com a rede que houver, e cai a menos de um terço. As respostas JSON da API vão juntas: o token viaja
	# no cabeçalho Authorization, posto pelo aplicativo, e não num cookie que o navegador mandaria sozinho,
	# então o tamanho da resposta comprimida não serve para adivinhar um segredo. Só a resposta é
	# comprimida; o corpo da requisição passa como chega, e o teto abaixo não muda.
	encode zstd gzip

	# Teto único para o corpo de toda requisição, o dobro do maior limite por rota da aplicação. Quem
	# recusa o pedido grande demais é a aplicação, com o 413 e a explicação em português, ao ler o
	# cabeçalho ou ao passar do limite da rota. Este teto só age quando ela ainda não respondeu: corta
	# a transferência em 1 MiB e responde 502, e nenhum corpo maior chega a ela.
	request_body {
		max_size 1MiB
	}

	reverse_proxy app:8080 {
		# Na troca de versão, a aplicação antiga para antes de a nova subir, porque as duas não cabem
		# juntas na memória. Enquanto a conexão é recusada, cada requisição espera e tenta de novo a
		# cada segundo, por até 90 s: quem opera vê a tela esperando, e não um erro, que o aplicativo
		# não trataria como falta de rede. Só a falha de conexão é repetida, e nela a requisição
		# nunca chegou à aplicação. A que já estava em andamento quando a antiga fechou a conexão
		# volta com erro, porque repeti-la poderia gravar duas vezes; por isso o deploy de rotina é
		# de madrugada.
		lb_try_duration 90s
		lb_try_interval 1s

		# Só o bloco do aviso Pix, abaixo, escreve este cabeçalho, depois de verificar o certificado da
		# Efí. Vindo por aqui, ele seria de quem fez a requisição, e a aplicação o tomaria por conferido.
		header_up -X-Ecrx-Caixa-Certificado-Efi
	}
}

# Domínio só do aviso Pix da Efí, que exige dela um certificado de cliente emitido por uma das duas
# autoridades intermediárias do webhook, a de produção e a de homologação, de efi/. A Efí manda o
# cadastro sem certificado primeiro, e este bloco precisa recusar; o domínio do aplicativo, acima, não
# pede certificado, porque o navegador do balcão abriria a escolha de um certificado instalado.
#
# Com a verificação ligada, o proxy também recusa, com 421, a requisição cujo Host não é o nome que o
# cliente pediu no TLS: sem isso, um aviso aberto pelo domínio do aplicativo poderia pedir este bloco
# pelo Host e passar sem certificado.
#
# Sem o subdomínio configurado, o bloco fica num nome que só a própria máquina resolve, com o
# certificado da autoridade local do proxy, e o arquivo continua válido.
{$ECRX_CAIXA_WEBHOOK_DOMINIO} {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/efi/webhook-producao.crt /etc/caddy/efi/webhook-homologacao.crt
		}
	}

	request_body {
		max_size 1MiB
	}

	handle /api/webhooks/pix/* {
		reverse_proxy app:8080 {
			lb_try_duration 90s
			lb_try_interval 1s

			# A impressão digital do certificado verificado, que a aplicação exige no aviso. O valor
			# que vier do cliente é trocado por este.
			header_up X-Ecrx-Caixa-Certificado-Efi {http.request.tls.client.fingerprint}
		}
	}

	# O resto do aplicativo não é alcançável por aqui.
	handle {
		respond 404
	}
}
